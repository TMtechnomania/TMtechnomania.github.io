{
	"manifest_version": 3,
	"author": "buildwithkt.dev",
	"name": "Themes+ New Tab",
	"version": "1.0.5",
	"description": "Video-wallpaper new tab with weather, notes, tasks, timers, tools, bookmarks, tab manager & media controls on music/video sites.",
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"chrome_url_overrides": {
		"newtab": "newtab.html"
	},
	"permissions": [
		"storage",
		"unlimitedStorage",
		"tabs",
		"alarms",
		"notifications",
		"search",
		"permissions"
	],
	"optional_permissions": [
		"bookmarks",
		"<all_urls>",
		"video-capture",
		"audio-capture",
		"geolocation",
		"system.cpu",
		"system.memory",
		"system.storage"
	],
	"background": {
		"service_worker": "js/service.js",
		"type": "module"
	},
	"host_permissions": [
		"https://buildwithkt.dev/*",
		"https://api.openweathermap.org/*",
		"https://api.exchangerate-api.com/*"
	],
	"content_scripts": [
		{
			"matches": [
				"https://open.spotify.com/*",
				"https://www.youtube.com/*",
				"https://m.youtube.com/*",
				"https://soundcloud.com/*",
				"https://music.apple.com/*",
				"https://music.amazon.com/*",
				"https://www.twitch.tv/*",
				"https://www.netflix.com/*",
				"https://www.disneyplus.com/*",
				"https://www.hotstar.com/*",
				"https://www.disneyplus.hotstar.com/*",
				"https://vimeo.com/*"
			],
			"js": ["js/content/mediaContent.js"],
			"run_at": "document_idle"
		}
	]
}
