{
	"manifest_version": 3,
	"author": "buildwithkt.dev",
	"name": "Themes+ — New Tab Dashboard & Wallpapers",
	"version": "1.0.6",
	"description": "Custom new tab dashboard: 4K live wallpapers, notes, tasks, bookmarks, tabs, timers, media controls & tools. Fast, local & private.",
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"chrome_url_overrides": {
		"newtab": "newtab.html"
	},
	"permissions": [
		"storage",
		"unlimitedStorage",
		"tabs",
		"system.cpu",
		"system.memory",
		"system.storage",
		"alarms",
		"notifications",
		"search"
	],
	"optional_permissions": ["bookmarks"],
	"optional_host_permissions": ["<all_urls>"],
	"background": {
		"service_worker": "js/service.js",
		"type": "module"
	},
	"host_permissions": [
		"https://buildwithkt.dev/*",
		"https://api.open-meteo.com/*",
		"https://geocoding-api.open-meteo.com/*",
		"https://api.exchangerate-api.com/*"
	],
	"content_scripts": [
		{
			"matches": [
				"https://open.spotify.com/*",
				"https://www.youtube.com/*",
				"https://m.youtube.com/*",
				"https://soundcloud.com/*",
				"https://music.apple.com/*",
				"https://music.amazon.com/*",
				"https://www.twitch.tv/*",
				"https://www.netflix.com/*",
				"https://www.disneyplus.com/*",
				"https://www.hotstar.com/*",
				"https://www.disneyplus.hotstar.com/*",
				"https://vimeo.com/*"
			],
			"js": ["js/content/mediaContent.js"],
			"run_at": "document_idle"
		}
	]
}
